[package]
name = "fz"
version = "0.1.0"
edition = "2024"
license = "MIT"
description = "A minimal fzy-compatible fuzzy selector"

[dependencies]
rustix = { version = "1.1.4", features = ["termios", "event", "process", "stdio"] }

[target.'cfg(any(target_os = "linux", target_os = "macos"))'.dependencies]
libc = "0.2"

[dev-dependencies]
rustybench = "0.4"
laputa-ptytest = "0.4"

[[bench]]
name = "bench"
harness = false

[profile.release]
opt-level = 3
lto = "thin"
panic = "abort"
strip = false

[profile.dist]
inherits = "release"
lto = "fat"
codegen-units = 1
strip = true

[workspace]
